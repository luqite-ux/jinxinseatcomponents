          "values": {
            "who_eyebrow": {
              "en": "The company"
            },
            "who_title": {
              "en": "One supplier across structure, foam and assembly"
            },
            "who_paragraph_1": {
              "en": "We focus on the parts that make up an automotive seat: the structural frame, the molded foam that shapes comfort, and the complete assemblies that bring them together."
            },
            "who_paragraph_2": {
              "en": "Our quality management system is certified to IATF 16949:2016 for the design and production of seat components."
            },
            "customers_eyebrow": {
              "en": "Customer experience"
            },
            "customers_title": {
              "en": "Past supply experience across the automotive sector"
            },
            "customers_description": {
              "en": "Our company presentation names Dongfeng Commercial Vehicle, Lear, GAC Gonow, Geely and Shanghai Daimay among historical customers served. This is a record of past supply experience, not a statement of current partnership or endorsement."
